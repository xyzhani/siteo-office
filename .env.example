# ─────────────────────────────────────────────────────────────
# Siteo Office settings. Copy to .env (never commit .env).
# With NOTHING filled in, the app runs in DEMO mode: fictional businesses, rule-based agents, simulated payments.
# ─────────────────────────────────────────────────────────────

# ── Mode
# DEMO_MODE=true forces demo mode even if you have an AI key (good for a public demo). Default: demo when no AI key.
DEMO_MODE=
# PUBLIC_DEMO=true locks a hosted copy to demo mode even if keys are set (real searches/AI off, PayPal Sandbox only).
PUBLIC_DEMO=
PORT=3000
# Public URL of your app (for links in emails and PayPal return URLs). Render sets RENDER_EXTERNAL_URL automatically.
PUBLIC_URL=
# Optional: protect the dashboard's actions with a token (recommended for any public deploy that isn't demo-only)
ADMIN_TOKEN=

# ── AI (Claude is the default LLM provider)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
# The Claude model to use. Required for live mode. Pick one from https://docs.anthropic.com/en/docs/about-claude/models
CLAUDE_MODEL=
# Your model's price per million tokens (used for the cost cap). Check Anthropic's pricing page for your model.
AI_USD_PER_MTOK_INPUT=3
AI_USD_PER_MTOK_OUTPUT=15
# Stop a run when its AI spend reaches this many US dollars
MAX_AI_USD_PER_RUN=2

# ── Business search: osm (free, default) | google | apify
SEARCH_PROVIDER=osm
# A contact URL or email for OpenStreetMap's usage policy (sent in the User-Agent)
OSM_CONTACT=
GOOGLE_PLACES_API_KEY=
APIFY_TOKEN=
MAX_BUSINESSES_PER_RUN=12
SHORTLIST_SIZE=3

# ── Website audit (Google PageSpeed works without a key at low volume)
USE_PAGESPEED=true
PAGESPEED_API_KEY=

# ── Email: test (built-in test inbox, nothing leaves the app) | smtp
EMAIL_PROVIDER=test
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# While testing SMTP, send every email to yourself instead of the business
SMTP_TEST_RECIPIENT=

# ── PayPal (Sandbox first! developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From your app's Webhooks section in the PayPal dashboard; enables signature verification
PAYPAL_WEBHOOK_ID=
# Optional: let the official PayPal Agent Toolkit run Fluffy's invoice tools (npm install @paypal/agent-toolkit)
PAYPAL_AGENT_TOOLKIT=false
# Optional text shown next to the payment buttons on a public Sandbox demo, e.g. which sandbox buyer to log in with
DEMO_BUYER_HINT=

# ── Pacing + follow-ups
# Pause between steps so you can watch the office (ms). Default: 2200 in demo, 600 live.
PACE_MS=
# Draft a payment reminder when an invoice is unpaid this long (minutes). Default: 2 in demo, 4320 (3 days) live.
FOLLOWUP_AFTER_MINUTES=
DATA_DIR=data
